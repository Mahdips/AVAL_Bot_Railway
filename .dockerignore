install.sh
aval-bot-menu.sh
AVAL_Bot_upload/
AVAL_Bot_v1.1/
AVAL_Bot_v1.1.zip
run.bat
smoke_schema.db
NUL

.vscode/
.idea/
.DS_Store
Thumbs.db
